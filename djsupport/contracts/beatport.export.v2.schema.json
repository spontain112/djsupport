{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/beatport/contracts/beatport.export.v2.schema.json",
  "title": "Beatport Export V2",
  "description": "Credential-free public Beatport facts with occurrence-safe ordering.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "extracted_at", "track_count", "occurrences"],
  "properties": {
    "schema_version": {"const": "beatport.export/v2"},
    "source": {"$ref": "#/$defs/source"},
    "extracted_at": {"type": "string", "format": "date-time"},
    "track_count": {"type": "integer", "minimum": 1},
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/occurrence"}
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "beatport_id", "name"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^beatport:[a-z_]+:[1-9][0-9]*$"},
        "beatport_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "beatport_id", "canonical_url", "name"],
      "properties": {
        "kind": {"enum": ["track", "chart", "release", "label"]},
        "beatport_id": {"type": "integer", "minimum": 1},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.beatport\\.com/(track|chart|release|label)/[^/]+/[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "curator": {"$ref": "#/$defs/entity"}
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "occurrence_id", "track"],
      "properties": {
        "position": {"type": "integer", "minimum": 1},
        "occurrence_id": {"type": "string", "pattern": "^beatport:(track|chart|release|label):[1-9][0-9]*:[1-9][0-9]*$"},
        "track": {"$ref": "#/$defs/track"}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "beatport_id", "canonical_url", "title", "duration", "dates", "availability", "commerce", "preview"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^beatport:track:[1-9][0-9]*$"},
        "beatport_id": {"type": "integer", "minimum": 1},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.beatport\\.com/track/[^/]+/[1-9][0-9]*$"},
        "title": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1},
        "mix_name": {"type": "string"},
        "artists": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "remixers": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": {"type": "string"},
            "milliseconds": {"type": "integer", "minimum": 0}
          }
        },
        "isrc": {"type": "string"},
        "bpm": {"type": "number", "exclusiveMinimum": 0},
        "genre": {"$ref": "#/$defs/entity"},
        "subgenre": {"$ref": "#/$defs/entity"},
        "key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {"type": "integer", "minimum": 0},
            "name": {"type": "string"},
            "camelot_letter": {"enum": ["A", "B", "a", "b"]},
            "camelot_number": {"type": "integer", "minimum": 1, "maximum": 12}
          }
        },
        "release": {"$ref": "#/$defs/entity"},
        "label": {"$ref": "#/$defs/entity"},
        "catalog_number": {"type": "string"},
        "label_track_identifier": {"type": "string"},
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "published": {"type": "string"},
            "released": {"type": "string"}
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "worldwide": {"type": "boolean"},
            "streaming": {"type": "boolean"},
            "pre_order": {"type": "boolean"},
            "enabled": {"type": "boolean"},
            "hidden": {"type": "boolean"},
            "exclusive": {"type": "boolean"},
            "explicit": {"type": "boolean"},
            "classic": {"type": "boolean"}
          }
        },
        "commerce": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "price": {},
            "currency": {"type": "string"},
            "sale_type": {"type": "string"},
            "status": {"type": "string"}
          }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "start_ms": {"type": "integer", "minimum": 0},
            "end_ms": {"type": "integer", "minimum": 0}
          }
        },
        "artwork": {},
        "raw_public_facts": {"type": "object"}
      }
    }
  }
}
